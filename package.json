{
  "name": "dispatch",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app for scheduling social posts through Buffer, with a portrait timeline and landscape platform columns",
  "type": "module",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "prepare": "husky || true",
    "dev": "vite",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/mark-electron-cjs.mjs",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "release": "semantic-release"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.18.0",
    "husky": "^9.1.6",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
